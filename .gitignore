.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Gradle / Java (companion plugin)
.gradle/
*.class

# Logs and local scratch
*.log
logs/
tmp/
*.bak
.DS_Store

# Vanilla reference data is downloaded, not authored, and mechanically re-fetchable
# with tools/fetch_vanilla.py. The fetcher is tracked; its cache is not.
tools/vanilla_templates/

