# Build output. Everything here is reproducible from tools/, so it stays out of git.
build/
dist/
out/

# Generated intermediate artifacts. Reproducible byte-for-byte from the mod source;
# regenerate with `python3 tools/generate_pack.py` and inspect them there. The
# *schema* is tracked (see tools/intermediate.py), the instances are not.
intermediate/content.json
intermediate/carriers.json
intermediate/allocation.json
content.json
carriers.json
allocation.json

